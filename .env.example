# Plantilla de variables de entorno para event-rounting-libreria
# Copia este archivo a .env y ajusta los valores según tu entorno

# Azure Functions local runtime
FUNCTIONS_WORKER_RUNTIME=java
AzureWebJobsStorage=

# Azure Event Grid Topic (publisher)
EVENT_GRID_TOPIC_ENDPOINT=https://<tu-topic>.<region>-1.eventgrid.azure.net/api/events
EVENT_GRID_TOPIC_KEY=<REEMPLAZAR_EVENT_GRID_TOPIC_KEY>
